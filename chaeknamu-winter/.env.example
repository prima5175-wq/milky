# 이 파일을 복사해서 .env.local 로 만들고 값을 채워요. (.env.local 은 Git에 올라가지 않아요)

# Supabase (프로젝트 설정 > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키. 절대 화면/브라우저에 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 구글시트 미러 (서비스 계정)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# 사이트 주소 (매직링크 이동용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DB 연결 주소 (Supabase > Project Settings > Database > Connection string > Transaction pooler)
# 비워 두면 내 컴퓨터 임시 DB(.local-db)로 동작해요. 배포 환경에서는 반드시 채울 것
DATABASE_URL=
