# ───────── 개발 확인용 ─────────
# 1 이면 감수 전 시나리오 일부를 '임시 승인'으로 아동 화면에 보여 준다. 운영에서는 반드시 0 (또는 비워 둔다).
TOKI_DEMO_APPROVE=0

# ───────── AI 친구 (서버에서만 사용, 브라우저로 전달되지 않음) ─────────
# 비워 두면 키 없이 동작하는 오프라인 대체 응답으로 연습한다.
ANTHROPIC_API_KEY=
# 사용할 모델 (기본 claude-opus-5-5). 비용을 줄이려면 더 작은 모델 ID 로 바꿔 품질을 비교해 본다.
TOKI_AI_MODEL=

# ───────── 연구용 익명화 내보내기 (둘 다 있어야 켜진다. 비어 있으면 /api/export 는 막혀 있다) ─────────
# 관리자 토큰: 임의의 긴 문자열. 요청 헤더 x-admin-token 으로 보낸다.
TOKI_ADMIN_TOKEN=
# 가명(HMAC) 소금: 16자 이상 임의 문자열. 바꾸면 가명이 모두 달라지고, 유출되면 아동 id 를 되짚을 수 있으니 비밀로 보관한다.
TOKI_EXPORT_SALT=

# ───────── Supabase (아직 앱에 연결되지 않음 — 연결 작업 후 사용) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
