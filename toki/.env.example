# Supabase (로컬: supabase start 후 출력되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Claude API (서버에서만 사용. 비워 두면 오프라인 대체 응답으로 동작)
ANTHROPIC_API_KEY=
# 사용할 모델 (기본 claude-opus-5-5). 비용을 줄이려면 더 작은 모델 ID 로 바꿀 수 있다.
TOKI_AI_MODEL=
TOKI_DEMO_APPROVE=0   # 1 이면 개발 확인용으로 감수 전 시나리오 일부를 임시 승인 표시 (운영에서는 반드시 0)
